# Secret used to sign the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Base URL of the clinic API (api/). Required.
API_URL=http://localhost:4000

# Optional testing aid: "true" makes calls use the TURN relay only (see README, "Calls and TURN").
# Leave unset in normal use.
NEXT_PUBLIC_FORCE_TURN_RELAY=
