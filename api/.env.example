# Port the API listens on. The web app reaches it via API_URL.
PORT=4000

# Secret used to sign access tokens (at least 32 characters). Generate with: openssl rand -base64 48
JWT_SECRET=

# Postgres connection. Matches docker-compose.yml at the project root (npm run db:up).
DATABASE_URL=postgresql://clinic:clinic@localhost:5432/clinic

# Optional: Cloudflare TURN relay for calls (free up to 1,000 GB/month). Create a TURN key in the
# Cloudflare dashboard (Realtime > TURN Server) and paste its ID and API token. Set both or neither;
# without them calls use STUN only, which fails behind strict NATs and firewalls.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
